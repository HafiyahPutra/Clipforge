# ClipForge — Environment variables
# Every value is optional; the app runs with the defaults below.

# ---- Provider AI (OpenAI-compatible: 9Router, LiteLLM, Ollama, ...) ----
AI_BASE_URL=http://localhost:20128/v1
# Docker only: the provider running on your Mac is reachable as host.docker.internal.
DOCKER_AI_BASE_URL=http://host.docker.internal:20128/v1
AI_API_KEY=
# Leave empty to auto-discover the provider's models (GET /v1/models, or
# /v1/combos on 9Router/OmniRoute proxies). Set an id to pin one model.
AI_MODEL=
# Seconds before an AI request is aborted (per chunk). Local/slow models need more.
AI_TIMEOUT_SECONDS=180
# Connect-phase budget only; a dead endpoint fails fast instead of eating the read timeout.
AI_CONNECT_TIMEOUT_SECONDS=15
AI_TEMPERATURE=0.4
# Retries with exponential backoff for 429 / 5xx / timeouts (0 disables).
AI_MAX_RETRIES=3
AI_RETRY_BASE_SECONDS=2
# Comma-separated extra model ids to try if the primary fails.
AI_FALLBACK_MODELS=
# Score locally (speech density + pauses) when every model fails; the UI labels it.
AI_FALLBACK_HEURISTIC=true

# ---- Local transcription (faster-whisper / CTranslate2, CPU) ----
# tiny | base | small | medium | large-v3  (bigger = slower, more accurate)
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=5
WHISPER_VAD=true
# Empty = auto-detect the spoken language.
WHISPER_LANGUAGE=

# ---- Media download (yt-dlp / ffmpeg) ----
YTDLP_MAX_HEIGHT=1080
YTDLP_SOCKET_TIMEOUT=30
# Path to a Netscape cookies.txt file, needed for private/age-gated videos.
YTDLP_COOKIES_FILE=

# ---- Analysis ----
# Max upload size for local files, in megabytes.
MAX_UPLOAD_MB=2048
# Transcript characters sent to the AI per request (long videos are chunked).
ANALYZE_CHUNK_CHARS=6000
ANALYZE_MAX_CLIPS=12

# ---- Encoder: auto | videotoolbox | cpu | browser_wasm ----
FFMPEG_ENCODER=auto
# Extra FFmpeg binaries probed for the libass `ass` filter (Homebrew's default
# build has none). First match wins; PATH is always the last resort.
FFMPEG_FALLBACK_BINS=/opt/homebrew/opt/ffmpeg-full/bin/ffmpeg,/usr/local/opt/ffmpeg-full/bin/ffmpeg

# ---- Rendering (Phase 3) ----
RENDER_FPS=30
RENDER_CRF=22
RENDER_PRESET=veryfast
RENDER_VIDEO_BITRATE=8M
RENDER_AUDIO_BITRATE=160k
RENDER_MAX_CLIPS=20

# ---- Overlays & audio (Phase 4) ----
# BGM tracks live in $ASSETS_DIR/bgm, watermark logos in $ASSETS_DIR/watermarks.
ASSETS_DIR=./data/assets
ASSET_MAX_MB=64
BGM_DEFAULT_VOLUME=0.25
BGM_FADE_SECONDS=0.8
VOICE_BOOST_MAX=2.0

# ---- Face tracking & editor previews (Phase 5 / 6) ----
# Models ship in backend/cascades (MediaPipe BlazeFace + FaceLandmarker, YuNet, Haar),
# nothing is downloaded at runtime and nothing leaves the machine.
FACES_DIR=./data/faces
FACE_SAMPLE_FPS=2.0
FACE_MIN_HIT_RATIO=0.2
# Tracking pipeline defaults (Phase 6). Clip-type presets in
# backend/services/tracking/config.py override these per type; any key here can be
# overridden per run with TRACKING_<UPPER_KEY>, e.g. TRACKING_DEAD_ZONE=0.01.
# TRACKING_DETECT_FPS=10
# TRACKING_DETECT_INTERVAL=1
# TRACKING_ANALYSIS_WIDTH=640
# TRACKING_DEAD_ZONE=0.004
# TRACKING_MAX_SPEED=0.05
# TRACKING_HOLD_FRAMES=8
# TRACKING_SPEAKER_MIN_SWITCH=1.5
# TRACKING_SAVGOL_WINDOW=9
# TRACKING_SMOOTHING=one_euro
# --- Phase 7: shot list, hard cut, dynamic zoom ------------------------------
# TRACKING_SHOT_MIN_SECONDS=2.0      # minimum shot length (a hard cut has no transition)
# TRACKING_CUT_MIN_TALK=0.8          # new speaker must talk this long to earn a cut
# TRACKING_CUT_LOOKAHEAD=0.15        # cut this early so the new face is up on the first word
# TRACKING_CUT_MAX_PER_MINUTE=6      # above this the draft merges the shortest shots
# TRACKING_ZOOM_STRENGTH=0           # 0 = no dynamic zoom; podcast preset uses 1.0
# TRACKING_ZOOM_MIN=1.0
# TRACKING_ZOOM_MAX=1.4
# TRACKING_ZOOM_FACE_RATIO=0.30      # push in until the face is ~30% of frame height
# TRACKING_ZOOM_DELAY=0.6            # sustained speech before the push-in starts
# TRACKING_ZOOM_RELEASE=2.5          # silence before pulling back out
# TRACKING_ZOOM_MAX_RATE=0.5         # zoom units per second

# ---- Phase 7 stage 2: VAD + overlap → whole_frame ----
# Only `energy` ships by default; the detector is a protocol, so `webrtcvad`
# or a Silero ONNX export can be added without touching the pipeline.
# TRACKING_VAD_BACKEND=energy
# TRACKING_VAD_FRAME_MS=30          # analysis hop 10 ms, frame 30 ms
# TRACKING_VAD_HOP_MS=10
# TRACKING_VAD_MARGIN_DB=6.0         # enter speech +6 dB above the noise floor
# TRACKING_VAD_RELEASE_DB=4.0        # exit when energy drops 4 dB below entry
# TRACKING_VAD_FLOOR_PERCENTILE=10.0 # noise floor = 10th percentile of RMS
# TRACKING_VAD_PITCH_MIN=70          # autocorrelation pitch gate (Hz), reject sub-vocal rumble
# TRACKING_VAD_PITCH_MAX=350
# TRACKING_VAD_MIN_SPEECH=0.10       # drop runs shorter than this
# TRACKING_VAD_MAX_GAP=0.18          # bridge silence shorter than this
# TRACKING_VAD_TURN_TOLERANCE=0.45   # snap a turn onset onto the nearest speech frame

# TRACKING_OVERLAP_MIN_SECONDS=1.2  # ≥2 talkers for this long → whole_frame
# TRACKING_OVERLAP_MAX_GAP=0.3
# TRACKING_WHOLE_FRAME_ENABLED=true
# TRACKING_WHOLE_FRAME_BG=blurred    # blurred | solid | gradient
# TRACKING_WHOLE_FRAME_DIM=-0.08     # darken the blurred background by this
# TRACKING_WHOLE_FRAME_BLUR=24

# ---- Phase 7 stage 3: manual shot editor ----
# Stored shot lists are sidecars written per (project, clip) here; the editor
# only touches this directory, never the project JSON.
SHOTS_DIR=./data/shots
PREVIEWS_DIR=./temp/previews
PREVIEW_WIDTH=540
PREVIEW_CRF=30
PREVIEW_PRESET=ultrafast
PREVIEW_MAX_SECONDS=20

# ---- Server ----
HOST=127.0.0.1
PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Optional protection for destructive endpoints (empty = open, local use) ----
ADMIN_API_KEY=

# ---- Storage (all paths are created on startup) ----
DATA_DIR=./data
TEMP_MAX_AGE_SECONDS=3600
TEMP_STORAGE_QUOTA_GB=5.0
CLEANUP_INTERVAL_SECONDS=1800
